# ============================================================
# AGV Robots (Pioneer 3-DX) with Camera + Supervisor + Lift
# ============================================================

# Robot 1 - starts at W1 (node 33)
Pioneer3dx {
  translation -0.5 0.5 0
  rotation 0 0 1 0
  name "AGV_1"
  supervisor TRUE
  controller "agv_mqtt_controller"
  controllerArgs ["1", "33"]
  extensionSlot [
    GPS {
      name "gps"
    }
    Compass {
      name "compass"
    }
    Camera {
      translation 0 0 0.02
      rotation 1 0 0 3.14159
      name "floor_camera"
      fieldOfView 1.2
      width 320
      height 240
      near 0.01
    }
    SliderJoint {
      jointParameters JointParameters {
        axis 0 0 1
      }
      device [
        LinearMotor {
          name "lift_motor"
          maxForce 100
          minPosition 0
          maxPosition 0.10
        }
        PositionSensor {
          name "lift_sensor"
        }
      ]
      endPoint Solid {
        translation 0 0 0.0
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 1.0 0.6 0.0
              roughness 0.3
              metalness 0.5
            }
            geometry Cylinder {
              radius 0.15
              height 0.02
            }
          }
        ]
        name "lift_platform"
        boundingObject Cylinder {
          radius 0.15
          height 0.02
        }
        physics Physics {
          density -1
          mass 0.5
        }
      }
    }
  ]
}

