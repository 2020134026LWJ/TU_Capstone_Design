# ============================================================
# AGV Robots (Pioneer 3-DX)
# ============================================================

# Robot 0 - starts at node 1 (0.5, 0.5)
Pioneer3dx {
  translation 0.5 0.5 0
  rotation 0 0 1 0
  name "AGV_0"
  controller "agv_mqtt_controller"
  controllerArgs ["0", "1"]
  extensionSlot [
    GPS {
      name "gps"
    }
    Compass {
      name "compass"
    }
  ]
}

# Robot 1 - starts at node 37 (1.5, 5.5)
Pioneer3dx {
  translation 1.5 5.5 0
  rotation 0 0 1 0
  name "AGV_1"
  controller "agv_mqtt_controller"
  controllerArgs ["1", "37"]
  extensionSlot [
    GPS {
      name "gps"
    }
    Compass {
      name "compass"
    }
  ]
}
