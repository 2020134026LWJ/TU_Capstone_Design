#VRML_SIM R2023b utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/robots/adept/pioneer3/protos/Pioneer3dx.proto"

WorldInfo {
  info [
    "AGV Warehouse Simulation - 7x7 Grid"
    "TU Capstone Design Project"
    "MQTT communication with bridge.py"
  ]
  title "AGV Warehouse 7x7"
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material1 "floor"
      material2 "wheel"
      coulombFriction [2]
    }
  ]
}

Viewpoint {
  orientation -1 0 0 1.5708
  position 3.5 3.5 14
}

TexturedBackground {
  texture "factory"
}

TexturedBackgroundLight {
}

# Warehouse floor (7x7 grid + workspace)
RectangleArena {
  translation 3.5 3.5 0
  floorSize 9 9
  floorTileSize 1 1
  floorAppearance PBRAppearance {
    baseColor 0.9 0.9 0.9
    roughness 1
    metalness 0
  }
  wallHeight 0.1
  wallAppearance PBRAppearance {
    baseColor 0.3 0.3 0.3
    roughness 0.5
  }
}

