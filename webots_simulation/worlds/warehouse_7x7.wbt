# ============================================================
# AGV Robots (Pioneer 3-DX)
# ============================================================

# Robot 1 - starts at W1 (node 50) - position (-0.5, 0.5)
Pioneer3dx {
  translation -0.5 0.5 0
  rotation 0 0 1 0
  name "AGV_1"
  controller "agv_mqtt_controller"
  controllerArgs ["1", "50"]
  extensionSlot [
    GPS {
      name "gps"
    }
    Compass {
      name "compass"
    }
  ]
}

# Robot 2 - starts at W2 (node 51) - position (-0.5, 6.5)
Pioneer3dx {
  translation -0.5 6.5 0
  rotation 0 0 1 0
  name "AGV_2"
  controller "agv_mqtt_controller"
  controllerArgs ["2", "51"]
  extensionSlot [
    GPS {
      name "gps"
    }
    Compass {
      name "compass"
    }
  ]
}
