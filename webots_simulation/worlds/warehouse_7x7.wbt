# ============================================================
# AGV Robots (Pioneer 3-DX) with Supervisor + Lift
# ============================================================

# Robot 1 - starts at W1 (node 50) - position (-0.5, 0.5)
Pioneer3dx {
  translation -0.5 0.5 0
  rotation 0 0 1 0
  name "AGV_1"
  supervisor TRUE
  controller "agv_mqtt_controller"
  controllerArgs ["1", "50"]
  extensionSlot [
    GPS {
      name "gps"
    }
    Compass {
      name "compass"
    }
    SliderJoint {
      jointParameters JointParameters {
        axis 0 0 1
      }
      device [
        LinearMotor {
          name "lift_motor"
          maxForce 100
          minPosition 0
          maxPosition 0.10
        }
        PositionSensor {
          name "lift_sensor"
        }
      ]
      endPoint Solid {
        translation 0 0 0.0
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 1.0 0.6 0.0
              roughness 0.3
              metalness 0.5
            }
            geometry Cylinder {
              radius 0.15
              height 0.02
            }
          }
        ]
        name "lift_platform"
        physics Physics {
          density -1
          mass 0.5
        }
      }
    }
  ]
}

